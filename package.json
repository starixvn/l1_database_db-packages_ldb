{
  "name": "@ldb/monorepo",
  "description": "Monorepo for @ldb packages",
  "homepage": "https://git3.nexdev.net/l1/database/db-packages/ldb",
  "bugs": "https://git3.nexdev.net/l1/database/db-packages/ldb/-/issues",
  "license": "ISC",
  "author": "Billy Bùi <billy.bui@lumiplus.vn> (https://git3.nexdev.net/billy.bui)",
  "contributors": [
    "Billy Bùi <billy.bui@lumiplus.vn> (https://git3.nexdev.net/billy.bui)"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://git3.nexdev.net/l1/database/db-packages/ldb.git"
  },
  "scripts": {
    "bootstrap": "pnpm install --force && pnpm --filter './packages/configs/*' build",
    "build": "pnpm --filter '@ldb/*' build"
  },
  "devDependencies": {
    "@ldb/eslint-config": "workspace:*",
    "@ldb/prettier-config": "workspace:*",
    "@ldb/tsconfig": "workspace:*",
    "@ldb/tsup-config": "workspace:*",
    "@ldb/vitest-config": "workspace:*",
    "@types/node": "22.13.10",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "tsup": "catalog:",
    "typescript": "5.8.2",
    "vitest": "catalog:"
  },
  "private": true,
  "workspaces": [
    "packages/**/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mongodb-js/zstd",
      "esbuild",
      "mongodb-client-encryption"
    ]
  }
}
