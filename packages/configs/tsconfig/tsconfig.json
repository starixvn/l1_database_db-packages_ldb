{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "sourceMap": false,
    "declaration": true,
    "declarationMap": false,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ESNext",
    "alwaysStrict": true,
    "allowJs": true,
    "checkJs": true,
    "pretty": true
  },
  "compileOnSave": true
}
